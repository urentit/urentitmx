# ── Auth (NextAuth + Auth0) ─────────────────────────────────────────────
# URL pública del cotizador (sin slash final). En Vercel: el dominio asignado.
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# https://<tenant>.us.auth0.com
AUTH0_ISSUER=

# ── Base de datos (MySQL en EC2; Prisma) ────────────────────────────────
# mysql://usuario:password@host:3306/urentitmx
DATABASE_URL=

# ── Legacy / fallback ───────────────────────────────────────────────────
# JSON Base64 con usuarios; solo se usa si no hay DATABASE_URL o la BD falla.
COTIZADOR_USERS=
